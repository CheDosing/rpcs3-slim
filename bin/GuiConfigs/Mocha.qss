/*
Mocha - RPCS3 Lite default theme
Minimal, macOS-inspired dark UI using the Catppuccin Mocha palette.

crust    #11111b   mantle   #181825   base     #1e1e2e
surface0 #313244   surface1 #45475a   surface2 #585b70
overlay0 #6c7086   overlay1 #7f849c
subtext0 #a6adc8   subtext1 #bac2de   text     #cdd6f4
mauve    #cba6f7   lavender #b4befe   blue     #89b4fa
green    #a6e3a1   yellow   #f9e2af   peach    #fab387
red      #f38ba8   teal     #94e2d5
*/

/* ---------- Base ---------- */
QWidget {
	color: #cdd6f4;
	background-color: transparent;
	selection-background-color: #cba6f7;
	selection-color: #11111b;
	alternate-background-color: #1a1a29;
	font-family: "Segoe UI Variable Text", "Segoe UI", "SF Pro Text", "Helvetica Neue", sans-serif;
	outline: none;
}
QMainWindow, QDialog {
	background-color: #1e1e2e;
}
QWidget:disabled {
	color: #6c7086;
}

/* Main window: kill the separator lines between toolbar, game list and docks */
QMainWindow::separator {
	background: #181825;
	width: 1px;
	height: 1px;
	border: none;
}
QMainWindow::separator:hover {
	background: #45475a;
}
QSplitter::handle {
	background: #181825;
}
QStatusBar {
	background: #181825;
	border: none;
}
QStatusBar::item {
	border: none;
}
QFrame[frameShape="4"], QFrame[frameShape="5"] { /* HLine / VLine */
	color: #313244;
	background: #313244;
	border: none;
}

/* ---------- Menus ---------- */
QMenuBar {
	background-color: #181825;
	border: none;
	padding: 2px 6px;
}
QMenuBar::item {
	background: transparent;
	padding: 4px 10px;
	border-radius: 6px;
}
QMenuBar::item:selected, QMenuBar::item:pressed {
	background: #313244;
}
QMenu {
	background-color: #181825;
	border: 1px solid #313244;
	border-radius: 10px;
	padding: 6px;
}
QMenu::item {
	padding: 5px 22px 5px 22px;
	border-radius: 6px;
	background: transparent;
}
QMenu::item:selected {
	background-color: #cba6f7;
	color: #11111b;
}
QMenu::item:disabled {
	color: #585b70;
	background: transparent;
}
QMenu::separator {
	height: 1px;
	background: #313244;
	margin: 5px 8px;
}
QMenu::indicator {
	width: 12px;
	height: 12px;
	left: 6px;
}
QMenu::indicator:checked {
	image: url("GuiConfigs/mocha/check.svg");
	background: #cba6f7;
	border-radius: 3px;
}

/* ---------- Toolbar ---------- */
QToolBar#mw_toolbar {
	background-color: #181825;
	border: none;
	padding: 4px 8px;
	spacing: 2px;
}
QToolBar#mw_toolbar::separator {
	background: #313244;
	width: 1px;
	margin: 8px 6px;
}
QToolButton {
	background: transparent;
	border: none;
	border-radius: 8px;
	padding: 4px 8px;
	color: #bac2de;
}
QToolButton:hover {
	background-color: #313244;
	color: #cdd6f4;
}
QToolButton:pressed, QToolButton:checked {
	background-color: #45475a;
}
QToolButton:disabled {
	color: #585b70;
}

/* Toolbar search: macOS pill */
QLineEdit#mw_searchbar {
	background: #313244;
	border: 1px solid transparent;
	border-radius: 14px;
	padding: 4px 12px;
	margin: 0.6em;
	color: #cdd6f4;
	selection-background-color: #cba6f7;
}
QLineEdit#mw_searchbar:focus {
	border: 1px solid #cba6f7;
}

/* Toolbar icon size slider */
QSlider#sizeSlider {
	background: transparent;
}
QSlider#sizeSlider::groove:horizontal {
	height: 4px;
	border-radius: 2px;
	background: #45475a;
}
QSlider#sizeSlider::sub-page:horizontal {
	border-radius: 2px;
	background: #cba6f7;
}
QSlider#sizeSlider::handle:horizontal {
	width: 14px;
	height: 14px;
	margin: -5px 0;
	border-radius: 7px;
	background: #cdd6f4;
}

/* ---------- Inputs ---------- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QKeySequenceEdit {
	background-color: #181825;
	border: 1px solid #313244;
	border-radius: 6px;
	padding: 3px 6px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
	border: 1px solid #cba6f7;
}
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
	background: transparent;
	border: none;
	width: 16px;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
	image: url("GuiConfigs/mocha/arrow-up.svg");
	width: 9px;
	height: 9px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
	image: url("GuiConfigs/mocha/arrow-down.svg");
	width: 9px;
	height: 9px;
}

QPushButton {
	background-color: #313244;
	border: 1px solid #45475a;
	border-radius: 7px;
	padding: 4px 14px;
	min-height: 1.3em;
}
QPushButton:hover {
	background-color: #45475a;
}
QPushButton:pressed {
	background-color: #585b70;
}
QPushButton:default {
	background-color: #cba6f7;
	border-color: #cba6f7;
	color: #11111b;
}
QPushButton:default:hover {
	background-color: #b4befe;
	border-color: #b4befe;
}
QPushButton:disabled {
	background-color: #1e1e2e;
	border-color: #313244;
	color: #585b70;
}
QPushButton:checked {
	background-color: #cba6f7;
	color: #11111b;
}

QComboBox {
	background-color: #313244;
	border: 1px solid #45475a;
	border-radius: 7px;
	padding: 3px 26px 3px 10px;
	min-height: 1.3em;
}
QComboBox:hover {
	background-color: #45475a;
}
QComboBox:disabled {
	background-color: #1e1e2e;
	border-color: #313244;
}
QComboBox::drop-down {
	border: none;
	width: 22px;
}
QComboBox::down-arrow {
	image: url("GuiConfigs/mocha/arrow-down.svg");
	width: 10px;
	height: 10px;
}
QComboBox::down-arrow:disabled {
	image: url("GuiConfigs/mocha/arrow-down-disabled.svg");
}
QComboBox QAbstractItemView {
	background-color: #181825;
	border: 1px solid #313244;
	border-radius: 8px;
	padding: 4px;
	selection-background-color: #cba6f7;
	selection-color: #11111b;
}

QCheckBox, QRadioButton {
	spacing: 7px;
	background: transparent;
}
QCheckBox::indicator, QRadioButton::indicator, QGroupBox::indicator {
	width: 14px;
	height: 14px;
	background-color: #181825;
	border: 1px solid #585b70;
}
QCheckBox::indicator, QGroupBox::indicator {
	border-radius: 4px;
}
QRadioButton::indicator {
	border-radius: 8px;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
	border-color: #cba6f7;
}
QCheckBox::indicator:checked, QGroupBox::indicator:checked {
	background-color: #cba6f7;
	border-color: #cba6f7;
	image: url("GuiConfigs/mocha/check.svg");
}
QCheckBox::indicator:indeterminate {
	background-color: #7f849c;
	border-color: #7f849c;
}
QRadioButton::indicator:checked {
	background-color: #cba6f7;
	border-color: #cba6f7;
	image: url("GuiConfigs/mocha/radio-dot.svg");
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
	background-color: #1e1e2e;
	border-color: #313244;
}
QCheckBox::indicator:checked:disabled {
	background-color: #45475a;
	border-color: #45475a;
	image: url("GuiConfigs/mocha/check-disabled.svg");
}

QSlider::groove:horizontal {
	height: 4px;
	border-radius: 2px;
	background: #45475a;
}
QSlider::sub-page:horizontal {
	border-radius: 2px;
	background: #cba6f7;
}
QSlider::handle:horizontal {
	width: 14px;
	height: 14px;
	margin: -5px 0;
	border-radius: 7px;
	background: #cdd6f4;
}
QSlider::handle:horizontal:disabled {
	background: #585b70;
}
QSlider::sub-page:horizontal:disabled {
	background: #45475a;
}

QProgressBar {
	background-color: #313244;
	border: none;
	border-radius: 5px;
	text-align: center;
	color: #cdd6f4;
	min-height: 10px;
}
QProgressBar::chunk {
	background-color: #cba6f7;
	border-radius: 5px;
}

/* ---------- Group boxes / tabs (settings) ---------- */
QGroupBox {
	background-color: #181825;
	border: 1px solid #313244;
	border-radius: 10px;
	margin-top: 1.4em;
	padding: 0.5em 0.4em 0.4em 0.4em;
}
QGroupBox::title {
	subcontrol-origin: margin;
	subcontrol-position: top left;
	left: 10px;
	padding: 0 4px;
	color: #a6adc8;
	font-weight: 600;
}

QTabWidget::pane {
	border: none;
	background: transparent;
	top: -1px;
}
QTabBar {
	qproperty-drawBase: 0;
	background: transparent;
}
QTabBar::tab {
	background: transparent;
	color: #a6adc8;
	border: none;
	border-radius: 7px;
	padding: 5px 12px;
	margin: 2px 2px 6px 2px;
}
QTabBar::tab:hover {
	background: #313244;
	color: #cdd6f4;
}
QTabBar::tab:selected {
	background: #313244;
	color: #cdd6f4;
	font-weight: 600;
}
QWidget#coreTab, QWidget#gpuTab, QWidget#audioTab, QWidget#inputTab,
QWidget#systemTab, QWidget#networkTab, QWidget#advancedTab, QWidget#emulatorTab,
QWidget#guiTab, QWidget#debugTab, QWidget#cg_disasm, QWidget#trophy_manager {
	background-color: #1e1e2e;
}
QScrollArea, QScrollArea > QWidget > QWidget {
	background: transparent;
	border: none;
}

/* ---------- Lists / tables (game list) ---------- */
QTableView, QTableWidget, QListView, QListWidget, QTreeView, QTreeWidget {
	background-color: #1e1e2e;
	alternate-background-color: #1a1a29;
	border: none;
	gridline-color: transparent;
	selection-background-color: #38cba6f7;
	selection-color: #cdd6f4;
}
QTableView::item, QListView::item, QTreeView::item {
	border: none;
	padding-left: 6px;
}
QTableView::item:selected, QListView::item:selected, QTreeView::item:selected {
	background-color: #38cba6f7;
	color: #cdd6f4;
}
QTableView::item:hover, QListView::item:hover, QTreeView::item:hover {
	background-color: #0dcdd6f4;
}
QTableCornerButton::section {
	background: #1e1e2e;
	border: none;
}
QHeaderView {
	background: #1e1e2e;
	border: none;
}
QHeaderView::section {
	background-color: #1e1e2e;
	color: #7f849c;
	border: none;
	border-bottom: 1px solid #313244;
	padding: 6px 8px;
	font-weight: 600;
}
QHeaderView::section:hover {
	color: #cdd6f4;
}
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
	border-image: none;
	image: url("GuiConfigs/mocha/branch-closed.svg");
}
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
	border-image: none;
	image: url("GuiConfigs/mocha/branch-open.svg");
}

/* Game grid */
#game_list_grid #flow_widget_content {
	background: #1e1e2e;
}
#game_list_grid_item {
	background: transparent;
	border-radius: 10px;
}
#game_list_grid_item:hover {
	background: #313244;
}
#game_list_grid_item[selected="true"], #game_list_grid_item:focus {
	background: #38cba6f7;
}
#game_list_grid_item #game_list_grid_item_title_label {
	color: #bac2de;
	background: transparent;
	font-weight: 600;
	font-size: 8pt;
	border: none;
}
#game_list_grid_item[selected="true"] #game_list_grid_item_title_label,
#game_list_grid_item[hover="true"] #game_list_grid_item_title_label,
#game_list_grid_item[focus="true"] #game_list_grid_item_title_label {
	color: #cdd6f4;
	background: transparent;
}

/* ---------- Scrollbars: thin, overlay-like ---------- */
QScrollBar:vertical {
	background: transparent;
	width: 10px;
	margin: 2px;
}
QScrollBar:horizontal {
	background: transparent;
	height: 10px;
	margin: 2px;
}
QScrollBar::handle:vertical {
	background: #45475a;
	border-radius: 3px;
	min-height: 30px;
	margin: 0 1px;
}
QScrollBar::handle:horizontal {
	background: #45475a;
	border-radius: 3px;
	min-width: 30px;
	margin: 1px 0;
}
QScrollBar::handle:hover {
	background: #6c7086;
}
QScrollBar::add-line, QScrollBar::sub-line {
	width: 0;
	height: 0;
	border: none;
	background: none;
}
QScrollBar::add-page, QScrollBar::sub-page {
	background: none;
}

/* ---------- Docks (log / TTY) ---------- */
QDockWidget {
	color: #a6adc8;
}
QDockWidget::title {
	background: #181825;
	padding: 5px 8px;
	border: none;
}
QDockWidget::close-button, QDockWidget::float-button {
	background: transparent;
	border: none;
	border-radius: 4px;
}
QDockWidget::close-button:hover, QDockWidget::float-button:hover {
	background: #313244;
}
[floating="true"] {
	background: #1e1e2e;
}

/* ---------- Tooltips ---------- */
QToolTip {
	background-color: #181825;
	color: #cdd6f4;
	border: 1px solid #313244;
	border-radius: 6px;
	padding: 5px 8px;
}

/* ---------- RPCS3 color hooks ---------- */
QLabel#toolbar_icon_color { color: #bac2de; }
QLabel#toolbar_icon_color_disabled { color: #585b70; }
QLabel#toolbar_icon_color_active { color: #cba6f7; }
QLabel#toolbar_icon_color_selected { color: #cdd6f4; }
QLabel#gamelist_icon_background_color { color: #1e1e2e; }
QLabel#save_manager_icon_background_color { color: #1e1e2e; }
QLabel#trophy_manager_icon_background_color { color: #1e1e2e; }
QLabel#savestate_manager_icon_background_color { color: #1e1e2e; }
QLabel#richtext_link_color { color: #89b4fa; }
QLabel#l_controller { color: #bac2de; }

QPlainTextEdit#log_frame, QPlainTextEdit#tty_frame {
	background-color: #11111b;
	border: none;
	border-radius: 0;
	font-family: "Cascadia Mono", "Consolas", "SF Mono", monospace;
}
QLabel#log_level_always { color: #94e2d5; }
QLabel#log_level_fatal { color: #f5c2e7; }
QLabel#log_level_error { color: #f38ba8; }
QLabel#log_level_todo { color: #fab387; }
QLabel#log_level_success { color: #a6e3a1; }
QLabel#log_level_warning { color: #f9e2af; }
QLabel#log_level_notice { color: #cdd6f4; }
QLabel#log_level_trace { color: #6c7086; }
QLabel#log_stack { color: #bac2de; }
QLabel#tty_text { color: #cdd6f4; }

QWidget#header_section { background-color: #181825; }
QDialog#kernel_explorer, QDialog#memory_viewer { background-color: #1e1e2e; }
QLabel#memory_viewer_address_panel { color: #89b4fa; background-color: #1e1e2e; }
QLabel#memory_viewer_hex_panel { color: #cdd6f4; background-color: #1e1e2e; }
QLabel#memory_viewer_ascii_panel { color: #a6adc8; background-color: #1e1e2e; }
QLabel#debugger_frame_breakpoint { color: #11111b; background-color: #f9e2af; }
QLabel#debugger_frame_pc { color: #11111b; background-color: #a6e3a1; }
QLabel#rsx_debugger_display_buffer { background-color: #1e1e2e; }

QWidget#trophy_notification_frame {
	background-color: #181825;
	color: #cdd6f4;
	border-radius: 10px;
}
